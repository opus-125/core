{
    "name": "opus/monorepo",
    "description": "Development monorepo for the Opus Symfony bundles.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symplify/monorepo-builder": "^12.5"
    },
    "replace": {
        "opus/audit-bundle": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Opus\\AuditBundle\\": "packages/audit-bundle/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opus\\AuditBundle\\Tests\\": "packages/audit-bundle/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "monorepo:validate": "monorepo-builder validate",
        "monorepo:merge": "monorepo-builder merge",
        "check": [
            "@monorepo:validate",
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
