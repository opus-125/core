{
    "name": "opus/audit-bundle",
    "description": "Tamper-evident audit trail with GDPR-compliant crypto-shredding and retention for Symfony applications.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "audit", "audit-trail", "gdpr", "compliance", "crypto-shredding", "doctrine"],
    "homepage": "https://github.com/opus-125/audit-bundle",
    "require": {
        "php": ">=8.4",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.4 || ^4.0",
        "psr/clock": "^1.0",
        "symfony/clock": "^8.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.2",
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/var-dumper": "^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Auto-registers the audit entity mappings and the onFlush listener (^3.2 for Symfony 8)."
    },
    "autoload": {
        "psr-4": {
            "Opus\\AuditBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opus\\AuditBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
