{
    "name": "opus/audit-bundle",
    "description": "Audit logging for Symfony applications.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "audit", "logging"],
    "homepage": "https://github.com/opus-125/audit-bundle",
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Opus\\AuditBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opus\\AuditBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
