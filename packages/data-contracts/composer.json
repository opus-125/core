{
    "name": "opus125/data-contracts",
    "description": "Personal-data vocabulary (attributes + interfaces) shared by the Opus125 GDPR and Audit bundles — no logic, no Doctrine binding.",
    "type": "library",
    "license": "MIT",
    "keywords": ["symfony", "gdpr", "dsgvo", "contracts", "personal-data", "attributes"],
    "homepage": "https://github.com/opus-125/data-contracts",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Opus125\\DataContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opus125\\DataContracts\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
