APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_a_real_app

# Doctrine connection used by the demo (and by the audit tables).
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/opus_audit_demo"

# Base64 of a 32-byte master key (KEK) for crypto-shredding.
# Generate your own with: php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
OPUS_AUDIT_KEK="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
